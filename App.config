<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Mobile Server Settings -->
    <add key="MobileServer.Port" value="5000" />
    <add key="MobileServer.PublicIpTimeout" value="5" />
    
    <!-- Capture Settings -->
    <add key="Capture.DefaultQuality" value="75" />
    <add key="Capture.CacheIntervalMs" value="100" />
    
    <!-- Logging -->
    <add key="Log.MaxFileSizeMB" value="10" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
